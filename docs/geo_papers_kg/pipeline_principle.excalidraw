      "id": "s5_action",
      "x": 360, "y": 2700, "width": 210, "height": 90,
      "strokeColor": "#b45309", "backgroundColor": "#fef3c7",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0, "seed": 500011,
      "version": 1, "versionNonce": 500012, "isDeleted": false,
      "groupIds": [], "boundElements": [{"id": "s5_action_t", "type": "text"}],
