    {
      "type": "rectangle",
      "id": "s4_primary",
      "x": 430, "y": 2020, "width": 470, "height": 80,
      "strokeColor": "#047857", "backgroundColor": "#a7f3d0",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0, "seed": 400009,
      "version": 1, "versionNonce": 400010, "isDeleted": false,
      "groupIds": [], "boundElements": [{"id": "s4_primary_t", "type": "text"}, {"id": "s4_arrow_a", "type": "arrow"}],
      "link": null, "locked": false, "roundness": {"type": 3}
    },
    {
      "type": "text",
      "id": "s4_primary_t",
      "x": 445, "y": 2033, "width": 440, "height": 54,
      "text": "NO (clues agree) -> PRIMARY PATH = plain GeoBayes multiply\nJust do the Section-2 update: multiply every confidence by its clue\nweight W, then rescale. Simple, and it keeps the strong contrasts.",
      "originalText": "NO (clues agree) -> PRIMARY PATH = plain GeoBayes multiply\nJust do the Section-2 update: multiply every confidence by its clue\nweight W, then rescale. Simple, and it keeps the strong contrasts.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle",
      "strokeColor": "#065f46", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0, "seed": 400011,
      "version": 1, "versionNonce": 400012, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": "s4_primary", "lineHeight": 1.3
    },

    {
      "type": "rectangle",
      "id": "s4_fallback",
      "x": 430, "y": 2130, "width": 470, "height": 90,
      "strokeColor": "#dc2626", "backgroundColor": "#fee2e2",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0, "seed": 400013,
      "version": 1, "versionNonce": 400014, "isDeleted": false,
      "groupIds": [], "boundElements": [{"id": "s4_fallback_t", "type": "text"}, {"id": "s4_arrow_b", "type": "arrow"}],
      "link": null, "locked": false, "roundness": {"type": 3}
    },
    {
      "type": "text",
      "id": "s4_fallback_t",
      "x": 445, "y": 2143, "width": 440, "height": 64,
      "text": "YES (clues fight) -> FALLBACK = Yager's cautious rule\nWhen clues strongly contradict, blind multiplying can produce a\nnonsense 'certain' answer. Yager parks the conflicting mass as\n'I don't know' instead of forcing a false winner. Safer under conflict.",
      "originalText": "YES (clues fight) -> FALLBACK = Yager's cautious rule\nWhen clues strongly contradict, blind multiplying can produce a\nnonsense 'certain' answer. Yager parks the conflicting mass as\n'I don't know' instead of forcing a false winner. Safer under conflict.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle",
      "strokeColor": "#7f1d1d", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0, "seed": 400015,
      "version": 1, "versionNonce": 400016, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": "s4_fallback", "lineHeight": 1.3
    },

