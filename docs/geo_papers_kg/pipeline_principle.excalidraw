      "id": "s5_map_label",
      "x": 120, "y": 2666, "width": 700, "height": 26,
      "text": "THE VOCABULARY  (plain word  =  POMDP term)",
      "originalText": "THE VOCABULARY  (plain word  =  POMDP term)",
