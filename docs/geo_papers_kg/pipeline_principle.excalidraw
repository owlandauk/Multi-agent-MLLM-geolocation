      "link": null, "locked": false, "roundness": {"type": 3}
    },
    {
      "type": "text",
      "id": "s2_before_t",
      "x": 135, "y": 1130, "width": 220, "height": 120,
      "text": "BEFORE (old confidence)\n\n  UK ........ 0.30\n  USA ....... 0.40\n  Japan ..... 0.30\n\n(USA is winning by default --\nremember this bias.)",
      "originalText": "BEFORE (old confidence)\n\n  UK ........ 0.30\n  USA ....... 0.40\n  Japan ..... 0.30\n\n(USA is winning by default --\nremember this bias.)",
