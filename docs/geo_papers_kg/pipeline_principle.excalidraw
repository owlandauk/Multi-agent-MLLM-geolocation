    {
      "type": "text",
      "id": "s4_title",
      "x": 120, "y": 1920, "width": 1400, "height": 34,
      "text": "MODULE 3 :  DST  -  actually applying the update, with a safety valve for contradictory clues  (modules/dst.py)",
      "originalText": "MODULE 3 :  DST  -  actually applying the update, with a safety valve for contradictory clues  (modules/dst.py)",
      "fontSize": 22, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0, "seed": 400001,
      "version": 1, "versionNonce": 400002, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "s4_intro",
      "x": 120, "y": 1966, "width": 1300, "height": 50,
      "text": "DST is the step that takes the scored clues and produces the NEW confidence table. It has two paths and picks between them based on one question:\ndo the clues mostly AGREE, or are they FIGHTING each other?",
      "originalText": "DST is the step that takes the scored clues and produces the NEW confidence table. It has two paths and picks between them based on one question:\ndo the clues mostly AGREE, or are they FIGHTING each other?",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0, "seed": 400003,
      "version": 1, "versionNonce": 400004, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.4
    },

